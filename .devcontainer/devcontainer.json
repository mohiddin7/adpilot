{
  "name": "AdPilot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip install --user -e '.[dev]'",
  "postAttachCommand": {
    "adpilot": "bash .devcontainer/start.sh"
  },
  "portsAttributes": {
    "8501": { "label": "Dashboard", "onAutoForward": "openPreview" },
    "8080": { "label": "API", "onAutoForward": "silent" }
  },
  "forwardPorts": [8501, 8080]
}
