# Copy to .env (gitignored). Only AGENT_LLM_BEARER_TOKEN is needed to try AdPilot locally.

# Data source: duckdb (bundled CSVs, no credentials) or bigquery
ADPILOT_CONNECTOR=duckdb

# LLM: OpenRouter, free models only. A free key: https://openrouter.ai/keys
AGENT_LLM_BEARER_TOKEN=
# Model chains: comma-separated, tried in order. Empty = the free defaults in code (docs/models.md).
AGENT_LLM_MODELS=
# Eval judge: its own chain, never sharing a model with the agent. Empty key = the agent's key.
JUDGE_LLM_BEARER_TOKEN=
JUDGE_LLM_MODELS=
JUDGE_LLM_ENDPOINT_URL=

# Audit trail: memory = run unrecorded; blank = BigQuery (needs the credentials below)
ADPILOT_AUDIT=memory
LOGFIRE_TOKEN=

# Layer 1 semantic input classifier: blank = off (no network). Set to `jev` to enable; requires JEV_API_KEY.
ADPILOT_INPUT_CLASSIFIER=
JEV_API_KEY=

# HTTP API and the dashboard that calls it. The key must be at least 24 characters.
ADPILOT_API_KEY=
ADPILOT_API_URL=http://localhost:8080

# BigQuery: only for --connector bigquery, the pipelines and the audit trail
BQ_PROJECT_ID=
BQ_LOCATION=
BQ_BRONZE_DATASET=adpilot_bronze
BQ_STAGING_DATASET=adpilot_staging
BQ_PRODUCTION_DATASET=adpilot_production
BQ_AUDIT_DATASET=adpilot_audit
GOOGLE_APPLICATION_CREDENTIALS=
GCP_SERVICE_ACCOUNT_JSON=
GCS_BUCKET_NAME=
RAW_BUCKET=
