# BigQuery — real values live in .env (gitignored)
BQ_PROJECT_ID=adpilot-lakehouse
BQ_BRONZE_DATASET=adpilot_bronze
BQ_STAGING_DATASET=adpilot_staging
BQ_PRODUCTION_DATASET=adpilot_production
GCS_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-sa-key.json

# Agent — data source for `adpilot chat`: duckdb (bundled CSVs, no credentials) or bigquery
ADPILOT_CONNECTOR=duckdb

# LLM — OpenRouter free tier by default. The agent reads OPENROUTER_API_KEY (LLM_BEARER_TOKEN works as an alias).
OPENROUTER_API_KEY=
LLM_ENDPOINT_URL=https://openrouter.ai/api/v1/chat/completions
LLM_BEARER_TOKEN=
LLM_TARGET_MODEL=inclusionai/ling-3.0-flash-vl:free
LLM_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free
